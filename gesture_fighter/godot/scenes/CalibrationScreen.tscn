[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/calibration_ui.gd" id="1_calib"]

[node name="CalibrationScreen" type="CanvasLayer"]
script = ExtResource("1_calib")

[node name="Background" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.05, 0.08, 0.15, 0.9)

[node name="Panel" type="PanelContainer" parent="."]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -250.0
offset_top = -180.0
offset_right = 250.0
offset_bottom = 180.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Panel"]
layout_mode = 2
alignment = 1

[node name="Title" type="Label" parent="Panel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.2, 0.85, 1, 1)
theme_override_font_sizes/font_size = 28
text = "GESTURE CONTROL CALIBRATION"
horizontal_alignment = 1

[node name="HSeparator" type="HSeparator" parent="Panel/VBox"]
layout_mode = 2

[node name="StepLabel" type="Label" parent="Panel/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "SHOW YOUR HAND TO THE CAMERA"
horizontal_alignment = 1

[node name="StatusLabel" type="Label" parent="Panel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.6, 0.6, 1)
theme_override_font_sizes/font_size = 16
text = "STEP 1 OF 7"
horizontal_alignment = 1

[node name="HSeparator2" type="HSeparator" parent="Panel/VBox"]
layout_mode = 2

[node name="StartButton" type="Button" parent="Panel/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "START FLIGHT"

[node name="KeyboardButton" type="Button" parent="Panel/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "USE KEYBOARD INSTEAD (WASD + SPACE)"
